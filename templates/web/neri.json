{
  "version": 2,
  "defaultUnit": "web",
  "units": {
    "core": {
      "kind": "library",
      "sources": ["vendor/sumi/core"]
    },
    "http": {
      "kind": "library",
      "sources": ["vendor/sumi/http"],
      "references": ["core"]
    },
    "app": {
      "kind": "library",
      "sources": ["app"],
      "references": ["core"]
    },
    "web": {
      "kind": "executable",
      "sources": ["main.hk"],
      "references": ["app", "http"]
    },
    "test": {
      "kind": "executable",
      "sources": ["tests"],
      "references": ["app"]
    }
  }
}
