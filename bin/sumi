#!/usr/bin/env bash
set -euo pipefail
SUMI_LAUNCHER="${BASH_SOURCE[0]}"
while [[ -L "$SUMI_LAUNCHER" ]]; do
  SUMI_LINK_DIR="$(cd -- "$(dirname -- "$SUMI_LAUNCHER")" && pwd -P)"
  SUMI_LAUNCHER="$(readlink "$SUMI_LAUNCHER")"
  [[ "$SUMI_LAUNCHER" = /* ]] || SUMI_LAUNCHER="$SUMI_LINK_DIR/$SUMI_LAUNCHER"
done
SUMI_ROOT="$(cd -- "$(dirname -- "$SUMI_LAUNCHER")/.." && pwd -P)"
if [[ ! -f "$SUMI_ROOT/build/latest-package" ]]; then
  printf 'SUMI_CHECKOUT_NOT_BUILT: Developer checkout. Run: bash "%s/scripts/build-package.sh"\n' "$SUMI_ROOT" >&2
  exit 1
fi
IFS= read -r SUMI_PACKAGE < "$SUMI_ROOT/build/latest-package"
exec "$SUMI_PACKAGE/bin/sumi" "$@"
