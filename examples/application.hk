use sumi
use host

namespace example

class GreetingService
  private prefix: String

  def init(prefix: String): Void
    this.prefix = prefix
  end

  def greet(name: String): String
    return this.prefix + name + "!"
  end
end

def application(greetings: GreetingService, log: fn(String): Void): App
  let app = new App()

  app.around() do |request, next|
    let response = next(request)

    log(request.path + " -> " + (response.status as String))

    return response
  end

  app.get("/") do |request|
    return sumi::text("Hello, Sumi!")
  end

  app.get("/hello/:name") do |request|
    let name = request.param("name")

    if name == null
      return sumi::text("Missing name", 400)
    end

    return sumi::text(greetings.greet(name))
  end

  app.get("/square/:value") do |request|
    let raw = request.param("value")

    if raw == null
      return sumi::text("Missing value", 400)
    end

    let value = host::parseInt(raw)

    if value == null
      return sumi::text("Expected an integer", 400)
    end

    if value < -1000 || value > 1000
      return sumi::text("Expected an integer between -1000 and 1000", 400)
    end

    return sumi::text((value * value) as String)
  end

  return app
end
