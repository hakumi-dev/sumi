use sumi
use example
use console
use host

def main(): Void
  let app = application(new GreetingService("Hello, ")) do |message|
    console.println(message)
  end

  let error = app.prepare()

  if error != null
    console.println(error.message)
    host.exit(1)
    return
  end

  let response = app.handle(new Request("GET", "/hello/Ada"))

  console.println(response.body)
end
