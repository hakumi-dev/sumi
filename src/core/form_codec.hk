use arrays
use result
use text
namespace sumi

def decodeForm(request: Request, options: FormOptions? = null): result::Result<Form, BodyFailure>
  let contentFailure = BodyMediaType.validate(request.contentType, "application/x-www-form-urlencoded")

  if contentFailure != null
    return result::Result<Form, BodyFailure>.Error(contentFailure)
  end
  return parseForm(request.body, options)
end

# WHATWG URL 5.1, with strict percent escapes and UTF-8 instead of replacement.
def parseForm(bytes: Byte[], options: FormOptions? = null): result::Result<Form, BodyFailure>
  let limits = options == null ? new FormOptions() : options

  if limits.maxBytes < 0 || limits.maxBytes > 1048576 || limits.maxFields < 0 || limits.maxFields > 65536 || limits.maxFieldBytes < 0 || limits.maxFieldBytes > 1048576 || limits.maxKeyBytes < 0 || limits.maxKeyBytes > 1048576
    return result::Result<Form, BodyFailure>.Error(new BodyFailure("invalid_options", "Form limits are outside their supported range"))
  end
  if bytes.Length > limits.maxBytes
    return result::Result<Form, BodyFailure>.Error(new BodyFailure("body_limit", "Encoded form exceeds maxBytes", limits.maxBytes))
  end
  var count = 0
  var start = 0
  var index = 0

  # Count before allocating field nodes, including repeated and empty names.
  while index <= bytes.Length
    if index == bytes.Length || bytes[index] == (38 as Byte)
      if index > start
        if count == limits.maxFields
          return result::Result<Form, BodyFailure>.Error(new BodyFailure("field_limit", "Form exceeds maxFields", start))
        end
        count = count + 1
      end
      start = index + 1
    end
    index = index + 1
  end
  var first: FormEntry? = null
  var last: FormEntry? = null

  start = 0
  while start < bytes.Length
    var endAt = start
    var equalAt = -1

    while endAt < bytes.Length && bytes[endAt] != (38 as Byte)
      if equalAt < 0 && bytes[endAt] == (61 as Byte)
        equalAt = endAt
      end
      endAt = endAt + 1
    end
    if endAt > start
      let keyEnd = equalAt < 0 ? endAt : equalAt
      let valueStart = equalAt < 0 ? endAt : equalAt + 1
      var name = ""
      var value = ""

      match FormDecoder.decodePart(bytes, start, keyEnd, limits.maxKeyBytes, "key_limit")
        case result::Result.Ok(decoded)
          name = decoded
        case result::Result.Error(failure)
          return result::Result<Form, BodyFailure>.Error(failure)
      end
      match FormDecoder.decodePart(bytes, valueStart, endAt, limits.maxFieldBytes, "value_limit")
        case result::Result.Ok(decoded)
          value = decoded
        case result::Result.Error(failure)
          return result::Result<Form, BodyFailure>.Error(failure)
      end
      let entry = new FormEntry(name, value)

      if last == null
        first = entry
      else
        last.next = entry
      end
      last = entry
    end
    start = endAt + 1
  end
  return result::Result<Form, BodyFailure>.Ok(new Form(first, count))
end

internal class FormDecoder
  private static def hex(byte: Int): Int
    if byte >= 48 && byte <= 57
      return byte - 48
    else if byte >= 65 && byte <= 70
      return byte - 55
    else if byte >= 97 && byte <= 102
      return byte - 87
    end
    return -1
  end

  static def decodePart(bytes: Byte[], start: Int, endAt: Int, maximum: Int, limitCode: String): result::Result<String, BodyFailure>
    var index = start
    var count = 0
    var remaining = 0
    var minimum = 128
    var maximumContinuation = 191
    var sequenceStart = start

    # Validate and measure decoded bytes before allocating the output buffer.
    while index < endAt
      let offset = index
      var byte = bytes[index] as Int

      if byte == 37
        if index + 2 >= endAt
          return result::Result<String, BodyFailure>.Error(new BodyFailure("invalid_percent", "Incomplete form percent escape", offset))
        end
        let high = FormDecoder.hex(bytes[index + 1] as Int)
        let low = FormDecoder.hex(bytes[index + 2] as Int)

        if high < 0 || low < 0
          return result::Result<String, BodyFailure>.Error(new BodyFailure("invalid_percent", "Form percent escape requires two hexadecimal digits", offset))
        end
        byte = high * 16 + low
        index = index + 2
      else if byte == 43
        byte = 32
      end
      if count == maximum
        return result::Result<String, BodyFailure>.Error(new BodyFailure(limitCode, "Decoded form component exceeds its byte limit", offset))
      end
      count = count + 1
      if remaining > 0
        if byte < minimum || byte > maximumContinuation
          return result::Result<String, BodyFailure>.Error(new BodyFailure("invalid_utf8", "Form component is not valid UTF-8", offset))
        end
        remaining = remaining - 1
        minimum = 128
        maximumContinuation = 191
      else if byte >= 128
        sequenceStart = offset
        if byte >= 194 && byte <= 223
          remaining = 1
        else if byte >= 224 && byte <= 239
          remaining = 2
          minimum = byte == 224 ? 160 : 128
          maximumContinuation = byte == 237 ? 159 : 191
        else if byte >= 240 && byte <= 244
          remaining = 3
          minimum = byte == 240 ? 144 : 128
          maximumContinuation = byte == 244 ? 143 : 191
        else
          return result::Result<String, BodyFailure>.Error(new BodyFailure("invalid_utf8", "Form component is not valid UTF-8", offset))
        end
      end
      index = index + 1
    end
    if remaining != 0
      return result::Result<String, BodyFailure>.Error(new BodyFailure("invalid_utf8", "Incomplete UTF-8 sequence in form component", sequenceStart))
    end
    let output: Byte[] = arrays::generate(count) do |position|
      return 0 as Byte
    end
    var target = 0

    index = start
    while index < endAt
      var byte = bytes[index] as Int

      if byte == 37
        byte = FormDecoder.hex(bytes[index + 1] as Int) * 16 + FormDecoder.hex(bytes[index + 2] as Int)
        index = index + 2
      else if byte == 43
        byte = 32
      end
      output[target] = byte as Byte
      target = target + 1
      index = index + 1
    end
    let decoded = text::fromBytes(output)

    if decoded == null
      return result::Result<String, BodyFailure>.Error(new BodyFailure("invalid_utf8", "Form component is not valid UTF-8", start))
    end
    return result::Result<String, BodyFailure>.Ok(decoded)
  end
end
