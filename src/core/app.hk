use host
use files
use result
namespace sumi

public class App
  private router: Router = new Router()
  private middleware: Middleware?
  private pipeline: (fn(Request): Response)?
  private error: ConfigurationError?

  def get(path: String, handler: fn(Request): Response): Void
    this.route("GET", path, handler)
  end

  def head(path: String, handler: fn(Request): Response): Void
    this.route("HEAD", path, handler)
  end

  def post(path: String, handler: fn(Request): Response): Void
    this.route("POST", path, handler)
  end

  def put(path: String, handler: fn(Request): Response): Void
    this.route("PUT", path, handler)
  end

  def patch(path: String, handler: fn(Request): Response): Void
    this.route("PATCH", path, handler)
  end

  def delete(path: String, handler: fn(Request): Response): Void
    this.route("DELETE", path, handler)
  end

  def options(path: String, handler: fn(Request): Response): Void
    this.route("OPTIONS", path, handler)
  end

  def route(method: String, path: String, handler: fn(Request): Response): Void
    if !this.canConfigure()
      return
    end
    this.error = this.router.add(method, path, handler)
  end

  # Explicit URL-to-file mapping; content is captured at registration.
  def file(path: String, source: String, contentType: String): Void
    if !this.canConfigure()
      return
    end
    if !validContentType(contentType)
      this.error = new ConfigurationError("Invalid content type for route " + path, "SUMI_CONTENT_TYPE")
      return
    end
    match files::readBytesOutcome(source, 1048576)
      case result::Result.Error(failure)
        let cause = failure.cause
        var detail = cause.code + " (OS " + (cause.osCode as String) + ")"
        let closed = failure.closeFailure

        if closed != null
          detail = detail + "; close: " + closed.code + " (OS " + (closed.osCode as String) + ")"
        end
        this.error = new ConfigurationError("Cannot read static file " + source + " for route " + path + ": " + detail, cause.code == "limit_exceeded" ? "SUMI_STATIC_SIZE" : "SUMI_STATIC_READ")
      case result::Result.Ok(body)
        this.get(path) do |request|
          return binary(copyBody(body), contentType)
        end
    end
  end

  def around(action: fn(Request, fn(Request): Response): Response): Void
    if !this.canConfigure()
      return
    end
    this.middleware = new Middleware(action, this.middleware)
  end

  def prepare(): ConfigurationError?
    if this.error != null
      return this.error
    end
    if this.pipeline != null
      return null
    end
    let router = this.router
    var pipeline: fn(Request): Response = fn(request)
      return router.dispatch(request)
    end
    var middleware = this.middleware

    while middleware != null
      pipeline = wrapMiddleware(middleware.action, pipeline)
      middleware = middleware.next
    end
    this.pipeline = pipeline
    return null
  end

  def handle(request: Request): Response
    let error = this.error

    if error != null
      return failure(error.code, error.message)
    end

    let pipeline = this.pipeline

    if pipeline == null
      return failure("SUMI_APP_NOT_READY", "Call App.prepare() and check its result before dispatching requests")
    end
    let incoming = new Request(request.method, request.path)

    incoming.body = copyBody(request.body)
    incoming.headers = copyHeaders(request.headers)
    incoming.contentType = request.contentType
    incoming.query = request.query
    incoming.requestId = request.requestId
    return pipeline(incoming)
  end

  private def canConfigure(): Bool
    if this.error != null
      return false
    end
    if this.pipeline != null
      this.error = new ConfigurationError("Application is already prepared", "SUMI_CONFIG_CLOSED")
      return false
    end
    return true
  end
end
