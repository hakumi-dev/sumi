use host
namespace sumi

def mediaToken(byte: Int): Bool
  return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 33 || byte == 35 || byte == 36 || byte == 37 || byte == 38 || byte == 39 || byte == 42 || byte == 43 || byte == 45 || byte == 46 || byte == 94 || byte == 95 || byte == 96 || byte == 124 || byte == 126
end

# Supported media types have an optional explicit UTF-8 charset.
def validContentType(value: String): Bool
  let length = host.stringByteLength(value)
  if length == 0 || length > 256
    return false
  end
  var slash = -1
  var index = 0
  while index < length
    let byte = host.stringByteAt(value, index) as Int
    if byte == 59
      return slash > 0 && index > slash + 1 && host.stringSlice(value, index, length - index) == "; charset=utf-8"
    end
    if byte == 47
      if slash >= 0 || index == 0
        return false
      end
      slash = index
    else if !mediaToken(byte)
      return false
    end
    index = index + 1
  end
  return slash > 0 && length > slash + 1
end
