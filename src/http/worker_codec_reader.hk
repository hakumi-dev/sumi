use arrays
use text
namespace sumiweb

internal class WorkerPacketReader
  private source: Byte[]
  private position: Int = 0
  private failed: Bool = false

  def init(source: Byte[]): Void
    this.source = source
    this.failed = source.Length > 1114112
  end

  def number(): Int
    if this.failed || this.source.Length - this.position < 4
      this.failed = true
      return -1
    end
    var value = 0
    var index = 0

    while index < 4
      value = value * 256 + (this.source[this.position] as Int)
      this.position = this.position + 1
      index = index + 1
    end
    return value
  end

  def bytes(maximum: Int): Byte[]?
    let length = this.number()

    if length < 0 || length > maximum || length > this.source.Length - this.position
      this.failed = true
      return null
    end
    let source = this.source
    let start = this.position

    this.position = this.position + length
    return arrays::generate<Byte>(length) do |index|
      return source[start + index]
    end
  end

  def string(maximum: Int): String?
    let bytes = this.bytes(maximum)

    if bytes == null
      return null
    end
    let value = text::fromBytes(bytes)

    this.failed = true if value == null
    return value
  end

  def complete(): Bool
    return !this.failed && this.position == this.source.Length
  end
end
