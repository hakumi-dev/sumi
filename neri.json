{
  "version": 2,
  "defaultUnit": "web",
  "units": {
    "core": {
      "kind": "library",
      "sources": ["src/core"]
    },
    "http": {
      "kind": "library",
      "sources": ["src/http"],
      "references": ["core"]
    },
    "example": {
      "kind": "library",
      "sources": ["examples"],
      "exclude": ["examples/memory.hk", "examples/web"],
      "references": ["core"]
    },
    "memory": {
      "kind": "executable",
      "sources": ["examples/memory.hk"],
      "references": ["example"]
    },
    "web": {
      "kind": "executable",
      "sources": ["examples/web"],
      "references": ["http"]
    },
    "contracts": {
      "kind": "executable",
      "sources": ["tests/contracts.hk"],
      "references": ["example"]
    },
    "http-contracts": {
      "kind": "executable",
      "sources": ["tests/web.hk"],
      "references": ["http"]
    },
    "logging": {
      "kind": "executable",
      "sources": ["tests/logging.hk"],
      "references": ["http"]
    },
    "environment": {
      "kind": "executable",
      "sources": ["tests/environment.hk"],
      "references": ["core"]
    },
    "cli": {
      "kind": "executable",
      "sources": ["cli"],
      "references": ["core"]
    }
  }
}
