{
  "version": 2,
  "defaultUnit": "web",
  "units": {
    "body-codecs": {
      "kind": "executable",
      "sources": ["tests/body_codecs.hk"],
      "references": ["core"]
    },
    "form-contracts": {
      "kind": "executable",
      "sources": ["tests/form_contracts.hk"],
      "references": ["core"]
    },
    "core": {
      "kind": "library",
      "sources": ["src/core"]
    },
    "http": {
      "kind": "library",
      "sources": ["src/http"],
      "references": ["core"]
    },
    "example": {
      "kind": "library",
      "sources": ["examples"],
      "exclude": ["examples/memory.hk", "examples/web"],
      "references": ["core"]
    },
    "memory": {
      "kind": "executable",
      "sources": ["examples/memory.hk"],
      "references": ["example"]
    },
    "web": {
      "kind": "executable",
      "sources": ["examples/web"],
      "references": ["http"]
    },
    "contracts": {
      "kind": "executable",
      "sources": ["tests/contracts.hk"],
      "references": ["example"]
    },
    "http-contracts": {
      "kind": "executable",
      "sources": ["tests/web.hk"],
      "references": ["http"]
    },
    "request-reader-contracts": {
      "kind": "executable",
      "sources": ["tests/request_reader.hk"],
      "references": ["http"]
    },
    "worker-codec-contracts": {
      "kind": "executable",
      "sources": ["tests/worker_codec.hk"],
      "references": ["http"]
    },
    "concurrent-contracts": {
      "kind": "executable",
      "sources": ["tests/concurrent.hk", "tests/concurrent_counter.hk"],
      "references": ["http"]
    },
    "lifecycle-contracts": {
      "kind": "executable",
      "sources": ["tests/lifecycle.hk"],
      "references": ["http"]
    },
    "logging": {
      "kind": "executable",
      "sources": ["tests/logging.hk"],
      "references": ["http"]
    },
    "environment": {
      "kind": "executable",
      "sources": ["tests/environment.hk"],
      "references": ["core"]
    },
    "cli": {
      "kind": "executable",
      "sources": ["cli"],
      "references": ["core", "package-common"]
    },
    "package-common": {
      "kind": "library",
      "sources": ["tooling/common.hk"]
    },
    "package-tool": {
      "kind": "executable",
      "sources": ["tooling/package.hk"],
      "references": ["package-common"]
    },
    "package-contracts": {
      "kind": "executable",
      "sources": ["tests/package_contracts.hk"],
      "references": ["package-common"]
    },
    "console-ui-contracts": {
      "kind": "executable",
      "sources": ["tests/console_ui.hk", "tests/console_screen.hk"],
      "references": ["package-common"]
    }
  }
}
